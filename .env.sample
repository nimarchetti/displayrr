# ==========================================
# DISPLAY REGISTRY
# One entry per physical display.
#   indicatrr_address  — ZMQ PUSH target; the Indicatrr/hub75pi PULL-binds here
#   events_bind_port   — switchrr PULL-binds here for hardware events from that display
#   pixel_format       — "L" (greyscale, default) or "RGB" (full colour)
#   frame_pub_address  — Docker service address switchrr SUB-connects to for each mode's frames
# ==========================================
DISPLAY_REGISTRY=[{"display_id":"default","width":256,"height":64,"indicatrr_address":"tcp://<indicatrr-ip>:5555","events_bind_port":5556,"pixel_format":"L","modes":[{"mode_name":"uk_tdd","display_name":"Train Departures","frame_pub_address":"tcp://boardrr:5600","default":true},{"mode_name":"powrr","display_name":"Power","frame_pub_address":"tcp://powrr:5601"},{"mode_name":"issrr","display_name":"ISS Tracker","frame_pub_address":"tcp://issrr:5602"},{"mode_name":"tiderr","display_name":"Tides","frame_pub_address":"tcp://tiderr:5603"}]},{"display_id":"hub75","width":256,"height":64,"indicatrr_address":"tcp://<hub75pi-ip>:5565","events_bind_port":5558,"pixel_format":"RGB","modes":[{"mode_name":"uk_tdd","display_name":"Train Departures","frame_pub_address":"tcp://boardrr:5600","default":true},{"mode_name":"powrr","display_name":"Power","frame_pub_address":"tcp://powrr:5601"},{"mode_name":"issrr","display_name":"ISS Tracker","frame_pub_address":"tcp://issrr:5602"},{"mode_name":"tiderr","display_name":"Tides","frame_pub_address":"tcp://tiderr:5603"}]}]

# ==========================================
# SWITCHRR ROUTING
# ==========================================
MODE_EVENTS_BIND_ADDRESS=tcp://0.0.0.0:5557
FRAME_TAP_BIND_ADDRESS=tcp://0.0.0.0:5650
FRAME_SEND_HWM=5
LOG_LEVEL=INFO
# Translate generic INPUT events into mode/encoder protocol.
# Keys: "device_id.event_type"  Values: MODE_SELECT, ENCODER_DELTA, ENCODER_PUSH
# toggle_0/encoder_0 = OLED Indicatrr; hub75_btn = hub75pi button HTTP server
INPUT_MAP={"toggle_0.select":"MODE_SELECT","encoder_0.delta":"ENCODER_DELTA","encoder_0.push":"ENCODER_PUSH","hub75_btn.select":"MODE_SELECT"}

# ==========================================
# DISPLAY DIMENSIONS (shared across modes)
# ==========================================
DISPLAY_WIDTH=256
DISPLAY_HEIGHT=64

# ==========================================
# POWRR — MQTT (Home Assistant broker)
# ==========================================
MQTT_HOST=<mqtt-broker-ip>
MQTT_PORT=1883
MQTT_USERNAME=<username>
MQTT_PASSWORD=<password>
GRAPH_WINDOW_SECONDS=3600

# ==========================================
# ISSRR — ISS Tracker display mode
# ==========================================
# Your location for visible pass predictions (decimal degrees).
# Leave blank to disable the Passes screen.
OBSERVER_LAT=
OBSERVER_LON=

# ==========================================
# TIDERR — Tide display mode
# ==========================================
# Comma-separated list of coastal locations (must match entries in ports.py).
# Encoder button cycles between them.
TIDERR_LOCATIONS=Filey Bay,Scarborough,Robin Hood's Bay,Whitby
