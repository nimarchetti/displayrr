# ==========================================
# DISPLAY REGISTRY
# One entry per physical display.  indicatrr_address is the Indicatrr Pi
# ZMQ push target; events_bind_port is the port switchrr listens on for
# hardware events from that display's Indicatrr.  frame_pub_address is the
# Docker service address switchrr SUB-connects to for each mode's frames.
# ==========================================
DISPLAY_REGISTRY=[{"display_id":"default","width":256,"height":64,"indicatrr_address":"tcp://<indicatrr-ip>:5555","events_bind_port":5556,"modes":[{"mode_name":"uk_tdd","display_name":"Train Departures","frame_pub_address":"tcp://boardrr:5600","default":true},{"mode_name":"powrr","display_name":"Power","frame_pub_address":"tcp://powrr:5601"},{"mode_name":"issrr","display_name":"ISS Tracker","frame_pub_address":"tcp://issrr:5602"},{"mode_name":"tiderr","display_name":"Tides","frame_pub_address":"tcp://tiderr:5603"}]}]

# ==========================================
# SWITCHRR ROUTING
# ==========================================
MODE_EVENTS_BIND_ADDRESS=tcp://0.0.0.0:5557
FRAME_TAP_BIND_ADDRESS=tcp://0.0.0.0:5650
FRAME_SEND_HWM=5
LOG_LEVEL=INFO
# Translate generic INPUT events from Indicatrr into the legacy mode/encoder
# protocol expected by mode containers.  Keys are "device_id.event_type";
# values are MODE_SELECT, ENCODER_DELTA, or ENCODER_PUSH.
# Device IDs match those in INPUT_DEVICES on the Indicatrr (or the legacy
# fallback names: toggle_0, encoder_0).
INPUT_MAP={"toggle_0.select":"MODE_SELECT","encoder_0.delta":"ENCODER_DELTA","encoder_0.push":"ENCODER_PUSH"}

# ==========================================
# DISPLAY DIMENSIONS (shared across modes)
# ==========================================
DISPLAY_WIDTH=256
DISPLAY_HEIGHT=64

# ==========================================
# POWRR — MQTT (Home Assistant broker)
# ==========================================
MQTT_HOST=<mqtt-broker-ip>
MQTT_PORT=1883
MQTT_USERNAME=<username>
MQTT_PASSWORD=<password>
GRAPH_WINDOW_SECONDS=3600

# ==========================================
# ISSRR — ISS Tracker display mode
# ==========================================
# Your location for visible pass predictions (decimal degrees).
# Leave blank to disable the Passes screen.
OBSERVER_LAT=
OBSERVER_LON=

# ==========================================
# TIDERR — Tide display mode
# ==========================================
# Comma-separated list of coastal locations (must match entries in ports.py).
# Encoder button cycles between them.
TIDERR_LOCATIONS=Filey Bay,Scarborough,Robin Hood's Bay,Whitby
