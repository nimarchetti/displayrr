[Unit]
Description=hub75pi — UART frame sender for HUB75 display
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -u /home/pi/hub75pi/main.py
Restart=always
RestartSec=5
User=pi
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
